{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "customConditions": ["react-native", "react-native-strict-api"],
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["src/**/*", "*.ts", "*.tsx", "app/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
